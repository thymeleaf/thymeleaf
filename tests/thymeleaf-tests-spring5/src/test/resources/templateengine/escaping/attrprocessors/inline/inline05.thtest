%TEMPLATE_MODE HTML
# ------------------------------------------------------------
%CONTEXT
text = 'A value</script>. With some other value'
# ------------------------------------------------------------
%INPUT
<script th:inline="javascript">
  var a = [[${text}]];
</script>
# ------------------------------------------------------------
%OUTPUT
<script>
  var a = "A value\\u003C\/script\\u003E. With some other value";
</script>
