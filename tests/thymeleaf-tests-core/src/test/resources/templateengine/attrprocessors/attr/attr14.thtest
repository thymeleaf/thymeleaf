%TEMPLATE_MODE HTML
# ------------------------------------------------------------
# The restriction applies to ANY "on*" attribute name, not only to well-known event handlers.
# ------------------------------------------------------------
%CONTEXT
one = 'one!'
# ------------------------------------------------------------
%INPUT
<div th:attr="onsearch=${one}">..</div>
# ------------------------------------------------------------
%EXCEPTION org.thymeleaf.exceptions.TemplateProcessingException
%EXCEPTION_MESSAGE_PATTERN (.*)\Qnumbers or booleans\E(.*)
