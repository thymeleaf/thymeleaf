%TEMPLATE_MODE HTML
# ------------------------------------------------------------
# Text (variable) results are forbidden in an "on*" attribute modified by th:attrprepend.
# ------------------------------------------------------------
%CONTEXT
one = 'one!'
# ------------------------------------------------------------
%INPUT
<div onclick="a();" th:attrprepend="onclick=${one}">..</div>
# ------------------------------------------------------------
%EXCEPTION org.thymeleaf.exceptions.TemplateProcessingException
%EXCEPTION_MESSAGE_PATTERN (.*)\Qnumbers or booleans\E(.*)
