%TEMPLATE_MODE HTML
# ------------------------------------------------------------
# Text (variable) results are forbidden in an "on*" attribute created by data-th-attr.
# ------------------------------------------------------------
%CONTEXT
one = 'one!'
# ------------------------------------------------------------
%INPUT
<div data-th-attr="onclick=${one}">..</div>
# ------------------------------------------------------------
%EXCEPTION org.thymeleaf.exceptions.TemplateProcessingException
%EXCEPTION_MESSAGE_PATTERN (.*)\Qnumbers or booleans\E(.*)
