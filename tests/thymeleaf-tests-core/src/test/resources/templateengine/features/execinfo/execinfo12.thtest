%TEMPLATE_MODE HTML
%TEMPLATE_MODE[somefrag] CSS
%TEMPLATE_MODE[somefrag2] HTML
%NAME execinfotest12
# ------------------------------------------------------------
%INPUT
<p th:text="${#execInfo.templateName}">the template name will be used</p>
...<p th:insert="somefrag">to be replaced by the fragment</p>...
<p th:text="${#execInfo.templateName}">the template name will be used</p>
# ------------------------------------------------------------
%INPUT[somefrag]
[# th:text="${#execInfo.templateName}"]the fragment name will be used[/]
([# th:insert="somefrag2"]to be replaced by the secondfragment[/])
[# th:text="${#execInfo.templateName}"]the fragment name will be used[/]
# ------------------------------------------------------------
%INPUT[somefrag2]
<span th:text="${#execInfo.templateName}">the fragment name will be used</span>
# ------------------------------------------------------------
%OUTPUT
<p>execinfotest12-001</p>
...<p>somefrag
(<span>somefrag2</span>)
somefrag</p>...
<p>execinfotest12-001</p>
