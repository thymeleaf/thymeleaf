%TEMPLATE_MODE HTML
%TEMPLATE_MODE[somefrag] CSS
%TEMPLATE_MODE[somefrag2] HTML
%NAME execinfotest15
# ------------------------------------------------------------
%INPUT
<p th:text="${#execInfo.templateModes}">the template name will be used</p>
...<p th:insert="somefrag">to be replaced by the fragment</p>...
<p th:text="${#execInfo.templateModes}">the template name will be used</p>
# ------------------------------------------------------------
%INPUT[somefrag]
[# th:text="${#execInfo.templateModes}"]the fragment name will be used[/]
([# th:insert="somefrag2"]to be replaced by the secondfragment[/])
[# th:text="${#execInfo.templateModes}"]the fragment name will be used[/]
# ------------------------------------------------------------
%INPUT[somefrag2]
<span th:text="${#execInfo.templateModes}">the fragment name will be used</span>
# ------------------------------------------------------------
%OUTPUT
<p>[HTML]</p>
...<p>\[HTML\,\ CSS\]
(<span>[HTML, CSS, HTML]</span>)
\[HTML\,\ CSS\]</p>...
<p>[HTML]</p>
