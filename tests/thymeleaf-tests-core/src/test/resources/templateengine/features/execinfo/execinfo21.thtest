%TEMPLATE_MODE HTML
%NAME execinfotest21
# ------------------------------------------------------------
%INPUT
<p th:text="${#execInfo.processedTemplateName}">the template name will be used</p>
...<p th:replace="somefrag">to be replaced by the fragment</p>...
<p th:text="${#execInfo.processedTemplateName}">the template name will be used</p>
# ------------------------------------------------------------
%INPUT[somefrag]
<p th:text="${#execInfo.processedTemplateName}">the fragment name will be used</p>
(<p th:replace="somefrag2">to be replaced by the secondfragment</p>)
<p th:text="${#execInfo.processedTemplateName}">the fragment name will be used</p>
# ------------------------------------------------------------
%INPUT[somefrag2]
<p th:text="${#execInfo.processedTemplateName}">the fragment name will be used</p>
# ------------------------------------------------------------
%OUTPUT
<p>execinfotest21-001</p>
...<p>execinfotest21-001</p>
(<p>execinfotest21-001</p>)
<p>execinfotest21-001</p>...
<p>execinfotest21-001</p>
