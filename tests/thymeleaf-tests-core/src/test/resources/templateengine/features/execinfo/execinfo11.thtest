%TEMPLATE_MODE HTML
%NAME execinfotest11
# ------------------------------------------------------------
%INPUT
<p th:text="${#execInfo.templateName}">the template name will be used</p>
...<p th:insert="somefrag">to be replaced by the fragment</p>...
<p th:text="${#execInfo.templateName}">the template name will be used</p>
# ------------------------------------------------------------
%INPUT[somefrag]
<p th:text="${#execInfo.templateName}">the fragment name will be used</p>
(<p th:insert="somefrag2">to be replaced by the secondfragment</p>)
<p th:text="${#execInfo.templateName}">the fragment name will be used</p>
# ------------------------------------------------------------
%INPUT[somefrag2]
<p th:text="${#execInfo.templateName}">the fragment name will be used</p>
# ------------------------------------------------------------
%OUTPUT
<p>execinfotest11-001</p>
...<p><p>somefrag</p>
(<p><p>somefrag2</p></p>)
<p>somefrag</p></p>...
<p>execinfotest11-001</p>
