%TEMPLATE_MODE HTML
%NAME execinfotest09
# ------------------------------------------------------------
%INPUT
<p th:text="${#execInfo.templateName}">the template name will be used</p>
...<p th:replace="somefrag">to be replaced by the fragment</p>...
<p th:text="${#execInfo.templateName}">the template name will be used</p>
# ------------------------------------------------------------
%INPUT[somefrag]
<p th:text="${#execInfo.templateName}">the fragment name will be used</p>
(<p th:replace="somefrag2">to be replaced by the secondfragment</p>)
<p th:text="${#execInfo.templateName}">the fragment name will be used</p>
# ------------------------------------------------------------
%INPUT[somefrag2]
<p th:text="${#execInfo.templateName}">the fragment name will be used</p>
# ------------------------------------------------------------
%OUTPUT
<p>execinfotest09-001</p>
...<p>somefrag</p>
(<p>somefrag2</p>)
<p>somefrag</p>...
<p>execinfotest09-001</p>
