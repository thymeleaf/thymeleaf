%TEMPLATE_MODE HTML
# ------------------------------------------------------------
%CONTEXT
v = 'V'
# ------------------------------------------------------------
%INPUT
<p>1<2 [[${v}]] and 3 <= [(${v})] <=[[${v}]]</p>
<div><1<span th:text="${v}">s</span></div>
<ul></ <li th:text="${v}">i</li></ul>
<p>a <@x> b <#y> c </1> d </> e <\u00E9> f</p>
# ------------------------------------------------------------
%OUTPUT
<p>1<2 V and 3 <= V <=V</p>
<div><1<span>V</span></div>
<ul></ <li>V</li></ul>
<p>a <@x> b <#y> c </1> d </> e <\u00E9> f</p>
